<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/tvWidgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Libros/Películas pendientes"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Pending count -->
    <TextView
        android:id="@+id/tvPendingCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cargando..."
        android:textSize="16sp"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Reminder message -->
    <TextView
        android:id="@+id/tvReminderMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recuerda actualizar su estado si los has terminado para mantener un seguimiento adecuado."
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@android:color/darker_gray" />
</LinearLayout>